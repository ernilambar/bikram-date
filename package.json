{
  "name": "bikram-date",
  "version": "1.0.0",
  "keywords": [
    "wordpress",
    "wordpress-plugin"
  ],
  "homepage": "https://github.com/ernilambar/bikram-date",
  "bugs": {
    "url": "https://github.com/ernilambar/bikram-date/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ernilambar/bikram-date.git"
  },
  "license": "GPL-2.0-or-later",
  "author": "Nilambar Sharma",
  "type": "module",
  "main": "bikram-date.php",
  "scripts": {
    "build": "vite build",
    "predeploy": "rimraf build deploy vendor && pnpm run ready",
    "deploy": "packtor",
    "format": "prettier \"**/*.{css,js,json,mjs}\" --write --log-level warn",
    "ready": "pnpm run vendor && pnpm run build",
    "vendor": "composer install --no-dev --no-scripts -o",
    "version": "easy-replace-in-files"
  },
  "browserslist": "> 2%, last 2 versions, not dead",
  "devDependencies": {
    "@wordpress/prettier-config": "^4.52.0",
    "easy-replace-in-files": "^2.0.0",
    "packtor": "^2.0.0",
    "postcss": "^8.5.25",
    "postcss-nested": "^8.0.1",
    "postcss-preset-env": "^11.3.2",
    "prettier": "npm:wp-prettier@^3.0.3",
    "rimraf": "^6.1.3",
    "vite": "^8.2.0"
  }
}
